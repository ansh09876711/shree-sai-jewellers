{
  "version": 2,
  "name": "shree-sai-jewellers",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/products", "destination": "/products.html" },
    { "source": "/product-detail", "destination": "/product-detail.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/offers", "destination": "/offers.html" },
    { "source": "/search", "destination": "/search.html" },
    { "source": "/order-success", "destination": "/order-success.html" },
    { "source": "/order-tracking", "destination": "/order-tracking.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    },
    {
      "source": "/(app\\.js|config\\.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
